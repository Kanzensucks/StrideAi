# Telegram Bot (create via BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token

# Strava API (register at developers.strava.com)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_VERIFY_TOKEN=strideai2026

# Anthropic (separate key with spend cap recommended)
ANTHROPIC_API_KEY=your_api_key

# Deployment
PUBLIC_DOMAIN=your-railway-domain.railway.app
DATA_DIR=/data

# Limits
MAX_USERS=50
